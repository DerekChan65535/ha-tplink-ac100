{
  "config": {
    "step": {
      "user": {
        "title": "Connect to a TL-AC100 controller",
        "description": "Connect to the local controller. Setup and polling are read-only. Plain HTTP does not protect credentials or traffic; use a trusted network.",
        "data": {
          "host": "Controller address",
          "username": "Username",
          "password": "Password"
        },
        "data_description": {
          "host": "Hostname, IP address, or HTTP(S) origin, optionally including a port. Do not include a URL path.",
          "username": "An existing controller account.",
          "password": "The controller account password."
        }
      },
      "reconfigure": {
        "title": "Change the controller address",
        "description": "The new address must belong to the same controller.",
        "data": {
          "host": "Controller address"
        },
        "data_description": {
          "host": "Hostname, IP address, or HTTP(S) origin, optionally including a port."
        }
      },
      "reauth_confirm": {
        "title": "Reauthenticate the controller",
        "description": "Enter the current credentials for this controller.",
        "data": {
          "username": "Username",
          "password": "Password"
        },
        "data_description": {
          "username": "An existing controller account.",
          "password": "The current controller account password."
        }
      }
    },
    "error": {
      "invalid_auth": "Authentication failed. Check the controller username and password.",
      "cannot_connect": "Could not connect to the controller.",
      "unsupported_device": "This device is not a supported TL-AC100 controller.",
      "unknown": "The controller returned an unsupported response or an unexpected error occurred.",
      "session_busy": "This account already has another management session. Sign out in the other management client or wait for that session to expire, then try again. The integration will not force a takeover.",
      "account_locked": "The controller has temporarily locked this account after too many failed sign-in attempts. Wait until the lock ends, then try again."
    },
    "abort": {
      "already_configured": "This controller is already configured.",
      "wrong_device": "The address belongs to a different controller. The existing configuration has not been changed.",
      "reauth_successful": "Authentication was updated successfully.",
      "reconfigure_successful": "The controller address was updated successfully."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Controller management",
        "description": "Monitoring is read-only by default. Device control allows explicit management actions: indicator LEDs, AP radios, wireless networks, controller settings and name, Save configuration and reboots. It also allows actions on each Wi-Fi client: its name on the controller, rate limit, AP binding, allowed times, disconnecting it and clearing its saved record. Most control entities are created disabled; enable only the ones you need. The client controls are listed on each client's page even while this option is off, and stay unavailable until it is on. Each action is sent once and is never repeated automatically. Changes stay in the controller's running configuration until Save configuration is pressed, and saving also stores changes made outside Home Assistant. Turning a radio or wireless network off disconnects its clients. A client's rate limit, binding or allowed times can cut it off from the network, and clearing its saved record deletes that record on the controller. Before an LED action, one AP configuration row is checked in memory for LED/Wi-Fi synchronization; it is not saved or logged, and LED control requires synchronization to be off.",
        "data": {
          "enable_control": "Enable device control",
          "monitor_wireless_services": "Monitor wireless networks"
        },
        "data_description": {
          "enable_control": "Allow explicit management actions. This setting does not run any action by itself.",
          "monitor_wireless_services": "Add a device for each wireless network (SSID), with its status and, when device control is enabled, its settings. The controller returns Wi-Fi and RADIUS keys together with the SSID list. They are dropped in memory and are never stored, logged or shown. When this is off, the SSID list is not requested."
        }
      }
    }
  },
