  "exceptions": {
    "control_disabled": {
      "message": "Device control is disabled. Enable it in the integration options before using management actions."
    },
    "invalid_auth": {
      "message": "Controller authentication failed. Reauthenticate the integration."
    },
    "control_failed": {
      "message": "The controller could not complete the action. Check the device state before trying again."
    },
    "control_unavailable": {
      "message": "The device is offline or is not managed by this controller."
    },
    "session_busy": {
      "message": "This account already has another management session. Sign out in the other management client or wait for that session to expire, then try again. The integration will not force a takeover."
    },
    "led_wifi_sync_unsafe": {
      "message": "LED control was blocked because LED/WiFi synchronization could not be confirmed off. This prevents a possible WiFi change. The integration does not change the synchronization setting."
    },
    "account_locked": {
      "message": "The controller has temporarily locked this account after too many failed sign-in attempts. Wait until the lock ends, then try again."
    },
    "session_expired": {
      "message": "The controller session expired and the action was not retried automatically. Check the current state and run the action again if it is still needed."
    }
  }
